# Versão XAMPP: o Apache só deve servir a pasta xampp/ (telas e API).
# Bloqueia documentação, arquivos internos e pastas de desenvolvimento (com gabarito ou configuração).
# (?i): sem diferenciar maiúsculas, porque no Windows "Backend" e "backend" são a mesma pasta.
RedirectMatch 404 (?i)^.*/(backend|frontend|scripts|docs|node_modules|\.git)(/.*)?$
<FilesMatch "^(\.env.*|package(-lock)?\.json|.*\.md)$">
  Require all denied
</FilesMatch>
