{
  "name": "simple-education",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de apoio ao estudo de matemática para o Ensino Médio",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "iniciar": "node scripts/iniciar.mjs",
    "verificar": "node scripts/verificar.mjs",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:check": "npm run db:check -w backend",
    "test": "npm test -w backend",
    "content:export": "npm run content:export -w backend",
    "content:export-sql": "npm run content:export-sql -w backend",
    "setup": "npm run db:migrate && npm run db:seed && npm run db:check",
    "apresentacao": "npm run build && npm start"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
