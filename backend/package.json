{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed/index.js",
    "db:reset": "node src/db/reset.js",
    "db:check": "node src/db/check.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "content:export": "node src/db/seed/export.js",
    "content:export-sql": "node src/db/seed/export-sql.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
