# Copie este arquivo para backend/.env e ajuste com os dados do SEU MySQL.
# Não coloque este arquivo .env no GitHub (ele já está no .gitignore).

# development | production
NODE_ENV=development

# Porta do servidor (site + API)
PORT=3001

# ---- MySQL ----
# XAMPP costuma usar: usuário root e senha vazia.
# MySQL Server/Workbench: use o usuário e a senha definidos na instalação.
# Senha com # ou espaço vai entre aspas: DB_PASSWORD="minha#senha"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Banco do sistema (criado automaticamente se não existir)
DB_NAME=simple_education
# Banco usado SOMENTE pelos testes (é apagado e recriado a cada execução).
# Precisa terminar em _test e ser diferente de DB_NAME.
DB_NAME_TEST=simple_education_test

# Validade da sessão em dias
SESSION_DAYS=7

# Cookie "Secure": deixe false para rodar em http://localhost.
# Use true apenas quando o sistema estiver publicado com HTTPS.
# Se não for informado, vale true quando NODE_ENV=production.
COOKIE_SECURE=false

# Origens autorizadas a chamar a API de outro endereço (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# true somente se o servidor estiver atrás de um proxy reverso
TRUST_PROXY=false

# Limite de tentativas de login com erro (por IP + e-mail) e a janela em minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Exibe no terminal método, rota, status e tempo de cada requisição
LOG_REQUESTS=true
